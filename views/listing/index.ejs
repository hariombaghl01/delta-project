<% layout("layouts/boilerplate") %>
<body>
    <h3>All Listings</h3>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
  <% for (let listing of allListing) { %>

    <a href="/listings/<%=listing._id%>" class="listing-link">
    <div class=" card col">
      <div class="card h-100">
        <img 
          src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/400' %>" 
          class="card-img-top" 
          alt="listing_image"
          style="height: 20rem;">
        <div class="card-body">
          <p class="card-text">
            <%= listing.title %> <br>
            ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
            </p>
        </div>
      </div>
    </div>
    </a>
  <% } %>
</div>
</body>


